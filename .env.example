# Пример локальной конфигурации для реальных вызовов OpenRouter.
# Скопируйте файл в `.env` и заполните значения.

# Обязательный API-ключ OpenRouter.
OPENROUTER_API_KEY=

# Модель по умолчанию для runtime-вызовов LLM-узлов.
# Для недорогого demo-цикла можно использовать, например:
# - meta-llama/llama-3.1-8b-instruct
# - qwen/qwen-2.5-7b-instruct
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Базовый URL OpenRouter (обычно менять не нужно).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
